  let visible = 0;
  document.querySelectorAll('.product-card').forEach(card => {
    const match = !q || card.dataset.search.includes(q);
    card.classList.toggle('hidden-by-search', !match);
    if (match) visible++;
  });
  noResults.classList.toggle('show', visible === 0);
  searchMeta.textContent = q ? `${visible} من أصل ${PRODUCTS.length} عطور تطابق "${q}"` : '';
}
searchInput.addEventListener('focus', () => searchBar.classList.add('active'));
searchInput.addEventListener('blur', () => { if (!searchInput.value) searchBar.classList.remove('active'); });
searchInput.addEventListener('input', () => { searchBar.classList.add('active'); runSearch(); });
document.getElementById('search-clear').addEventListener('click', () => {
  searchInput.value = ''; runSearch(); searchBar.classList.remove('active'); searchInput.focus();
});

