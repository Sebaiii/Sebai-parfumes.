  orderState = { product, size: size || '50', qty: 1 };

  document.getElementById('order-img').src = product.img;
  document.getElementById('order-img').alt = 'SEBAI ' + product.name;
  document.getElementById('order-title').textContent = product.name;
  document.getElementById('order-subtitle').textContent = product.notes.join(' · ');

  const sizesWrap = document.getElementById('order-sizes');
  sizesWrap.innerHTML = Object.keys(product.prices).map(s => `
    <button class="order-size-btn ${s === orderState.size ? 'active' : ''}" data-size="${s}">${s}ml</button>
  `).join('');
  sizesWrap.querySelectorAll('.order-size-btn').forEach(btn => {
    attachTapRipple(btn);
    btn.addEventListener('click', () => {
      sizesWrap.querySelectorAll('.order-size-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      orderState.size = btn.dataset.size;
      updateOrderTotal();
    });
  });

  document.getElementById('qty-value').textContent = orderState.qty;
  document.getElementById('order-city').value = '';
  updateOrderTotal();
  document.getElementById('order-overlay').classList.add('show');
}

function updateOrderTotal() {
  const unit = orderState.product.prices[orderState.size];
  const total = unit * orderState.qty;
  document.getElementById('order-total-value').textContent = `${total} درهم`;
}

document.getElementById('qty-minus').addEventListener('click', () => {
  orderState.qty = Math.max(1, orderState.qty - 1);
  document.getElementById('qty-value').textContent = orderState.qty;
  updateOrderTotal();
});
document.getElementById('qty-plus').addEventListener('click', () => {
  orderState.qty = Math.min(9, orderState.qty + 1);
  document.getElementById('qty-value').textContent = orderState.qty;
  updateOrderTotal();
});

function closeOrder() { document.getElementById('order-overlay').classList.remove('show'); }
document.getElementById('order-close').addEventListener('click', closeOrder);
document.getElementById('order-overlay').addEventListener('click', e => {
  if (e.target.id === 'order-overlay') closeOrder();
});

document.getElementById('order-confirm').addEventListener('click', () => {
  const { product, size, qty } = orderState;
  const unit = product.prices[size];
  const total = unit * qty;
  const city = document.getElementById('order-city').value.trim();

  let msg = `مرحباً دار *السباعي للعطور الفاخرة* ✨\n\n`;
  msg += `أرغب بطلب:\n`;
  msg += `🌸 العطر: ${product.name}\n`;
  msg += `📏 الحجم: ${size}ml\n`;
  msg += `🔢 الكمية: ${qty}\n`;
  msg += `💰 السعر الإجمالي: ${total} درهم\n`;
  if (city) msg += `📍 المدينة: ${city}\n`;
  msg += `\nبانتظار تأكيد الطلب، شكراً 🙏`;

  window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  closeOrder();
});

/* ════════════════════════════════
   QUIZ LOGIC — routes into the same order modal
════════════════════════════════ */
function findPerfume(productId) {
  const product = PRODUCTS.find(p => p.id === productId);
  const resultBox = document.getElementById('quiz-result');
  document.getElementById('quiz-res-title').textContent = 'العطر المرشح لك: ' + product.name;
  document.getElementById('quiz-res-desc').textContent = product.desc;
  resultBox.classList.add('show');

  const btn = document.getElementById('quiz-res-btn');
  btn.onclick = () => openOrder(product.id, '50');
}

/* ════════════════════════════════
   CURSOR GLOW + SCROLL REVEAL + HERO LOAD
════════════════════════════════ */
const glow = document.getElementById('cursor-glow');
document.addEventListener('mousemove', e => {
  glow.style.left = e.clientX + 'px';
  glow.style.top  = e.clientY + 'px';
});

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('active'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

window.addEventListener('load', () => document.getElementById('hero').classList.add('loaded'));
</script>
</body>
