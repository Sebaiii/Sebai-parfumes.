<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>السباعي — Seba3i Parfums de Haute Parfumerie</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,500&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

<style>
/* ════════════════════════════════
   DESIGN TOKENS — "روبي وذهب" (Ruby & Gold)
   Two accents, one job each: ruby carries commerce and urgency
   (buy, order, price), gold carries craft and trust (verification,
   ratings, dividers). Each fragrance also keeps a signature hue
   pulled straight from its own bottle, so six products never blur
   into one template.
════════════════════════════════ */
:root {
  --bg-dark:     #0A0706;
  --surface:     #120D0B;
  --card-bg:     #17110E;
  --glass:       rgba(20, 15, 12, 0.66);
  --border-gold: rgba(212, 175, 55, 0.16);
  --border-glow: rgba(212, 175, 55, 0.42);
  --gold:        #D4AF37;
  --gold-light:  #F3E3A3;
  --gold-dark:   #8A6A1E;
  --ruby:        #AE1B34;
  --ruby-bright: #E8425F;
  --ruby-deep:   #650F20;
  --text-main:   #EDE3D3;
  --text-muted:  #93816C;
  --white:       #ffffff;
  --green-wa:    #25D366;
  --radius:      10px;
  --transition:  all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: 'Tajawal', sans-serif;
  background-color: var(--bg-dark);
  color: var(--text-main);
  line-height: 1.8;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

.cinzel { font-family: 'Cinzel', serif; }
.serif  { font-family: 'Playfair Display', serif; }
.container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

button, input { font-family: inherit; }
button { cursor: pointer; }

::selection { background: var(--ruby); color: var(--white); }

/* ════════════════════════════════
   MOTION — global keyframes
   Ripples answer a user action (search typing, taps). The single
   ambient motion is the two wave dividers; everything else waits
   for the person to do something first.
════════════════════════════════ */
@keyframes dropRipple {
  0%   { transform: scale(1);   opacity: .7; }
  100% { transform: scale(9);   opacity: 0;  }
}
@keyframes tapRipple {
  0%   { transform: scale(0);  opacity: .38; }
  100% { transform: scale(22); opacity: 0;   }
}
@keyframes waveDrift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(-18px); }
}
@keyframes sheetUp {
  from { transform: translateY(24px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes fadeScale { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }

.wave-anim { animation: waveDrift 8s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) {
  .wave-anim { animation: none !important; }
  * { scroll-behavior: auto !important; }
}

/* focus visibility (accessibility floor) */
a:focus-visible, button:focus-visible, input:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 2px;
}

/* ════════════════════════════════
   AMBIENT BACKGROUND + CURSOR GLOW
════════════════════════════════ */
.ambient-bg {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(circle at 12% 18%, rgba(212, 175, 55, 0.05) 0%, transparent 45%),
    radial-gradient(circle at 88% 78%, rgba(174, 27, 52, 0.06) 0%, transparent 50%);
  filter: blur(40px);
}
#cursor-glow {
  position: fixed; pointer-events: none; z-index: 9999;
  width: 420px; height: 420px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.07) 0%, rgba(174,27,52,0.05) 45%, transparent 70%);
  transform: translate(-50%, -50%);
  transition: left 0.12s ease-out, top 0.12s ease-out;
}
@media (hover: none) { #cursor-glow { display: none; } }

/* ════════════════════════════════
   NAVIGATION
════════════════════════════════ */
nav {
  position: fixed; top: 0; width: 100%; z-index: 1000;
  padding: 0 40px; height: 78px;
  display: flex; align-items: center; justify-content: space-between;
  background: var(--glass);
  backdrop-filter: blur(25px) saturate(180%);
  border-bottom: 1px solid var(--border-gold);
  transition: var(--transition);
}
.nav-logo {
  font-family: 'Cinzel', serif;
  font-size: 1.5rem; font-weight: 700; letter-spacing: 0.2em;
  color: var(--gold); text-decoration: none; text-transform: uppercase;
  display: flex; align-items: center; gap: 8px;
}
.nav-logo span { font-family: 'Playfair Display', serif; font-style: italic; font-weight: 400; color: var(--gold-light); }
.nav-links { display: flex; gap: 2.6rem; }
.nav-links a {
  color: var(--text-muted); font-size: 0.82rem; letter-spacing: 0.14em;
  text-decoration: none; text-transform: uppercase; font-weight: 500;
  transition: var(--transition); position: relative;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: -6px; left: 0; width: 0; height: 1px;
  background: var(--ruby-bright); transition: var(--transition);
}
.nav-links a:hover { color: var(--gold); }
.nav-links a:hover::after { width: 100%; }

.nav-actions { display: flex; align-items: center; gap: 0.9rem; }
.nav-icon-btn {
  width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.03); border: 1px solid var(--border-gold); color: var(--gold-light);
  transition: var(--transition); position: relative; overflow: hidden;
}
.nav-icon-btn:hover { border-color: var(--gold); background: rgba(212,175,55,0.08); }

.nav-cta {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--ruby-deep), var(--ruby));
  color: var(--white); padding: 0.65rem 1.6rem; border-radius: var(--radius);
  font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em;
  text-decoration: none; transition: var(--transition); border: 1px solid rgba(232,66,95,0.4);
  box-shadow: 0 4px 18px rgba(174, 27, 52, 0.3); display: inline-flex; align-items:center; gap:8px;
}
.nav-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 28px rgba(174, 27, 52, 0.5); }

/* ════════════════════════════════
   HERO
════════════════════════════════ */
#hero {
  min-height: 100vh; position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center; text-align: center;
  padding-top: 80px;
}
.hero-bg {
  position: absolute; inset: 0;
  background:
    linear-gradient(180deg, rgba(10,7,6,0.55), rgba(10,7,6,0.97)),
    url('data:image/jpeg;base64,') center 22%/cover no-repeat;
  transform: scale(1.05); transition: transform 8s ease;
}
#hero.loaded .hero-bg { transform: scale(1); }

.hero-content { position: relative; z-index: 2; max-width: 900px; padding: 0 20px; }
.hero-tag {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 6px 20px; border-radius: 30px;
  background: rgba(212, 175, 55, 0.08); border: 1px solid var(--border-gold);
  color: var(--gold); font-size: 0.75rem; letter-spacing: 0.28em; text-transform: uppercase;
  margin-bottom: 2rem; backdrop-filter: blur(10px);
}
h1.hero-title {
  font-family: 'Cinzel', serif; font-size: clamp(3rem, 8vw, 6.2rem);
  font-weight: 700; line-height: 1.05; color: var(--white);
  letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1rem;
}
h1.hero-title span {
  display: block; font-family: 'Playfair Display', serif; font-style: italic;
  font-weight: 400; background: linear-gradient(90deg, var(--gold-light), var(--ruby-bright));
  -webkit-background-clip: text; background-clip: text; color: transparent;
  font-size: 0.52em; text-transform: none; padding-top: 0.3rem;
}
.hero-desc {
  font-size: clamp(1rem, 2vw, 1.2rem); color: var(--text-muted);
  max-width: 650px; margin: 0 auto 2.6rem; font-weight: 300;
}
.hero-btns { display: flex; gap: 1.1rem; justify-content: center; flex-wrap: wrap; }

.btn-ruby, .btn-glass {
  position: relative; overflow: hidden;
  padding: 1rem 2.6rem; border-radius: var(--radius);
  font-size: 0.85rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  text-decoration: none; transition: var(--transition); display: inline-flex; align-items:center; gap:10px;
  border: 1px solid transparent;
}
.btn-ruby {
  background: linear-gradient(135deg, var(--ruby), var(--ruby-bright));
  color: var(--white); box-shadow: 0 10px 30px rgba(174, 27, 52, 0.3);
}
.btn-ruby:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(174, 27, 52, 0.5); }
.btn-glass {
  background: rgba(255, 255, 255, 0.03); border-color: var(--border-gold);
  color: var(--text-main); backdrop-filter: blur(10px);
}
.btn-glass:hover { border-color: var(--gold); color: var(--gold); background: rgba(212, 175, 55, 0.05); }

/* wave divider — the single ambient/orchestrated motion moment */
.wave-divider { position: relative; height: 64px; margin-top: -2px; z-index: 3; }
.wave-divider svg { width: 100%; height: 100%; display: block; }

/* ════════════════════════════════
   MARQUEE STRIP
════════════════════════════════ */
.marquee-wrapper {
  background: var(--surface); border-y: 1px solid var(--border-gold);
  padding: 1rem 0; overflow: hidden; display: flex; position: relative; z-index: 2;
}
.marquee-track { display: flex; gap: 3rem; white-space: nowrap; animation: marquee 32s linear infinite; }
.marquee-item { font-family: 'Cinzel', serif; font-size: 0.8rem; letter-spacing: 0.25em; color: var(--gold); text-transform: uppercase; }
.marquee-item i { margin-inline-start: 3rem; font-size: 0.6rem; color: var(--ruby-bright); }

/* ════════════════════════════════
   SEARCH — droplet ripple on focus/typing
════════════════════════════════ */
#search-section { padding: 4.5rem 0 1rem; }
.search-wrap { max-width: 560px; margin: 0 auto; text-align: center; }
.search-wrap p.section-subtitle { margin-bottom: 0.6rem; }
.search-bar {
  position: relative; display: flex; align-items: center; gap: 12px;
  background: var(--card-bg); border: 1px solid var(--border-gold);
  border-radius: 999px; padding: 0.9rem 1.4rem; transition: border-color .35s ease, box-shadow .35s ease;
}
.search-bar.active { border-color: var(--ruby-bright); box-shadow: 0 0 0 4px rgba(232,66,95,0.08); }
.search-icon-wrap { position: relative; width: 20px; height: 20px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.search-icon-wrap i { color: var(--text-muted); font-size: 0.95rem; transition: color .3s ease; z-index: 2; position:relative; }
.search-bar.active .search-icon-wrap i { color: var(--ruby-bright); }
.ripple-ring {
  position: absolute; border: 1px solid var(--ruby-bright); border-radius: 50%;
  width: 9px; height: 9px; opacity: 0; pointer-events: none;
}
.search-bar.active .ripple-ring { animation: dropRipple 1.7s ease-out infinite; }
.ripple-ring:nth-child(2) { animation-delay: .45s !important; }
.ripple-ring:nth-child(3) { animation-delay: .9s !important; }
#search-input {
  flex: 1; background: transparent; border: none; outline: none;
  color: var(--text-main); font-size: 0.95rem;
}
#search-input::placeholder { color: var(--text-muted); }
#search-clear {
  background: none; border: none; color: var(--text-muted); font-size: 0.85rem;
  display: none; padding: 4px;
}
.search-bar.has-value #search-clear { display: inline-flex; }
#search-meta { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.7rem; min-height: 1.2em; }

/* ════════════════════════════════
   PERFUME QUIZ
════════════════════════════════ */
#quiz-section { padding: 5rem 0; background: var(--surface); border-bottom: 1px solid var(--border-gold); }
.quiz-card {
  background: var(--card-bg); border: 1px solid var(--border-gold); border-radius: 14px;
  padding: 3rem; text-align: center; max-width: 800px; margin: 0 auto;
  box-shadow: 0 20px 50px rgba(0,0,0,0.5); position: relative; overflow: hidden;
}
.quiz-card::before {
  content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.05), transparent 60%);
  pointer-events: none;
}
.quiz-options { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem; }
.quiz-opt-btn {
  position: relative; overflow: hidden;
  background: rgba(255,255,255,0.02); border: 1px solid var(--border-gold); color: var(--text-main);
  padding: 0.8rem 1.7rem; border-radius: var(--radius); transition: var(--transition);
  font-family: 'Tajawal', sans-serif; font-size: 0.9rem;
}
.quiz-opt-btn:hover { background: var(--ruby); color: var(--white); border-color: var(--ruby); }
#quiz-result { margin-top: 2rem; display: none; padding-top: 1.5rem; border-top: 1px dashed var(--border-gold); animation: fadeScale .4s ease; }
#quiz-result.show { display: block; }

/* ════════════════════════════════
   PRODUCTS
════════════════════════════════ */
#products { padding: 5.5rem 0 6rem; position: relative; z-index: 2; }
.section-header { margin-bottom: 3.5rem; text-align: center; }
.section-subtitle { font-size: 0.75rem; letter-spacing: 0.38em; color: var(--gold); text-transform: uppercase; display: block; margin-bottom: 0.8rem; }
.section-title { font-family: 'Cinzel', serif; font-size: clamp(2.1rem, 4vw, 3.1rem); color: var(--white); font-weight: 600; }

.product-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 2rem;
}
.product-card {
  background: var(--card-bg); border: 1px solid var(--border-gold);
  border-radius: var(--radius); overflow: hidden; position: relative;
  transition: var(--transition), opacity .3s ease, transform .3s ease;
  border-top: 3px solid var(--accent, var(--gold));
}
.product-card:hover {
  transform: translateY(-8px); border-color: var(--border-glow);
  box-shadow: 0 20px 40px rgba(0,0,0,0.7), 0 0 22px color-mix(in srgb, var(--accent, var(--gold)) 22%, transparent);
}
.product-card.hidden-by-search { display: none; }

.product-img-box { position: relative; aspect-ratio: 4/5; overflow: hidden; background:#000; }
.product-img-box img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
.product-card:hover .product-img-box img { transform: scale(1.07); }
.product-overlay { position: absolute; inset: 0; background: linear-gradient(to top, var(--card-bg) 0%, rgba(21,18,14,0.15) 55%, transparent 100%); }
.product-badge {
  position: absolute; top: 1rem; inset-inline-end: 1rem;
  background: rgba(15, 13, 10, 0.85); border: 1px solid var(--accent, var(--gold)); color: var(--accent, var(--gold));
  font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  padding: 0.3rem 0.8rem; border-radius: 20px; backdrop-filter: blur(5px);
}

.product-info { padding: 1.7rem; position: relative; }
.product-title { font-family: 'Playfair Display', serif; font-size: 1.55rem; color: var(--white); margin-bottom: 0.35rem; }
.product-desc { font-size: 0.84rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1rem; min-height: 2.6em; }

.notes-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 1.1rem; }
.note-chip {
  font-size: 0.68rem; color: var(--text-muted); border: 1px solid var(--border-gold);
  padding: 0.2rem 0.6rem; border-radius: 20px;
}

.size-selector { display: flex; gap: 8px; margin-bottom: 1rem; }
.size-btn {
  background: rgba(255,255,255,0.03); border: 1px solid var(--border-gold); color: var(--text-muted);
  padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; transition: var(--transition);
}
.size-btn.active, .size-btn:hover { border-color: var(--accent, var(--gold)); color: var(--accent, var(--gold)); background: rgba(212,175,55,0.08); }

.product-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 0.2rem; gap: 10px; }
.product-price { font-family: 'Cinzel', serif; font-size: 1.4rem; color: var(--ruby-bright); font-weight: 700; white-space: nowrap; }
.product-price span { font-size: 0.65rem; color: var(--text-muted); font-weight: 400; }

.btn-order {
  position: relative; overflow: hidden;
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 0.6rem 1.1rem; border-radius: 999px;
  background: linear-gradient(135deg, var(--ruby-deep), var(--ruby));
  border: 1px solid rgba(232,66,95,0.4);
  color: var(--white); text-decoration: none; transition: var(--transition);
  font-size: 0.78rem; font-weight: 700; letter-spacing: .02em; white-space: nowrap;
}
.btn-order:hover { transform: scale(1.04); box-shadow: 0 8px 22px rgba(174,27,52,0.4); }

#no-results { display: none; text-align: center; padding: 3rem 0; color: var(--text-muted); }
#no-results.show { display: block; }
#no-results i { font-size: 1.6rem; color: var(--gold); margin-bottom: .8rem; display:block; }

/* ════════════════════════════════
   REVIEWS
════════════════════════════════ */
#reviews { padding: 6.5rem 0; background: var(--surface); }
.reviews-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
.review-card { background: var(--card-bg); border: 1px solid var(--border-gold); padding: 2rem; border-radius: var(--radius); position: relative; }
.stars { color: var(--gold); font-size: 0.85rem; margin-bottom: 1rem; }
.review-text { font-size: 0.9rem; color: var(--text-main); font-style: italic; line-height: 1.7; margin-bottom: 1.5rem; }
.reviewer-info h4 { font-size: 0.9rem; color: var(--white); font-weight: 600; }
.reviewer-info p { font-size: 0.75rem; color: var(--text-muted); }

/* ════════════════════════════════
   ORDER MODAL
════════════════════════════════ */
#order-overlay {
  position: fixed; inset: 0; z-index: 3000; background: rgba(5,3,2,0.72); backdrop-filter: blur(3px);
  display: none; align-items: flex-end; justify-content: center;
}
#order-overlay.show { display: flex; }
@media (min-width: 720px) { #order-overlay { align-items: center; } }

.order-sheet {
  width: 100%; max-width: 460px; background: var(--card-bg); border: 1px solid var(--border-gold);
  border-radius: 18px 18px 0 0; padding: 2rem; position: relative; animation: sheetUp .35s cubic-bezier(.16,1,.3,1);
  max-height: 88vh; overflow-y: auto;
}
@media (min-width: 720px) { .order-sheet { border-radius: 18px; } }

.order-close {
  position: absolute; top: 1.1rem; inset-inline-end: 1.1rem; width: 34px; height: 34px; border-radius: 50%;
  background: rgba(255,255,255,0.04); border: 1px solid var(--border-gold); color: var(--text-muted);
  display: flex; align-items: center; justify-content: center;
}
.order-head { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.6rem; padding-inline-end: 2.4rem; }
.order-head img { width: 62px; height: 84px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-gold); }
.order-head h3 { font-family: 'Playfair Display', serif; color: var(--white); font-size: 1.35rem; }
.order-head p { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }

.order-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; }
.order-row > span:first-child { font-size: 0.85rem; color: var(--text-muted); }
.order-sizes { display: flex; gap: 8px; }
.order-size-btn {
  border: 1px solid var(--border-gold); background: transparent; color: var(--text-muted);
  padding: 6px 14px; border-radius: 999px; font-size: 0.8rem; transition: var(--transition);
}
.order-size-btn.active { border-color: var(--gold); color: var(--gold); background: rgba(212,175,55,0.08); }

.qty-stepper { display: flex; align-items: center; gap: 14px; }
.qty-btn {
  width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border-gold);
  background: transparent; color: var(--text-main); font-size: 1rem; display:flex; align-items:center; justify-content:center;
}
.qty-btn:hover { border-color: var(--gold); color: var(--gold); }
#qty-value { font-size: 0.95rem; min-width: 18px; text-align: center; }

.order-note { margin-bottom: 1.4rem; }
.order-note label { display:block; font-size: 0.82rem; color: var(--text-muted); margin-bottom: .5rem; }
.order-note input {
  width: 100%; background: rgba(255,255,255,0.02); border: 1px solid var(--border-gold); color: var(--text-main);
  border-radius: 8px; padding: 0.7rem 0.9rem; font-size: 0.85rem; outline: none;
}
.order-note input:focus { border-color: var(--gold); }

.order-total { display:flex; align-items:center; justify-content:space-between; padding: 1rem 0; border-top: 1px dashed var(--border-gold); margin-bottom: 1.4rem; }
.order-total span:first-child { color: var(--text-muted); font-size: 0.85rem; }
.order-total span:last-child { font-family: 'Cinzel', serif; color: var(--ruby-bright); font-size: 1.5rem; }

.btn-confirm {
  position: relative; overflow: hidden; width: 100%;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  background: linear-gradient(135deg, var(--green-wa), #1fae57);
  color: #08210f; font-weight: 800; letter-spacing: .02em; font-size: 0.92rem;
  padding: 1rem; border-radius: 12px; border: none;
}
